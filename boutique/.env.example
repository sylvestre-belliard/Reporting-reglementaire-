# Clé secrète Stripe (Tableau de bord Stripe > Développeurs > Clés API).
# Commencez par la clé de test sk_test_..., puis passez à sk_live_... une fois prêt.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Adresse publique du site (sans / final), utilisée pour les redirections après paiement.
SITE_URL=https://votre-boutique.netlify.app

# Pays de livraison acceptés (codes ISO séparés par des virgules).
PAYS_LIVRES=FR,BE,LU,CH,MC
